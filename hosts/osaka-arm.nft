# hosts/osaka-arm.nft
# 本机（osaka-arm）专属入站放行规则
# 公网放行端口：22 SSH / 80+443 npm 容器 / UDP 41641 Tailscale 直连
# 注意：不含任何公网 IP——入站按端口放行；SSH 来源白名单见 README（你可后续追加 ip saddr 限制）

# Tailscale 接口进来的流量全部放行（管理面 + tailnet 内互访）
iifname "tailscale0" accept
# Tailscale WireGuard 直连端口（提升 P2P 直连率，避免走 DERP 中继）
udp dport 41641 accept

# SSH（公网来源暂不限制；CGNAT/动态 IP 不适合固定白名单，由 fail2ban 保护）
tcp dport 22 accept
# npm 容器（80/443）
tcp dport 80 accept
tcp dport 443 accept

# ---- 远程接入 UDP 端口（历史任务确认）----
# mosh：默认端口范围 60000-61000（本机 mosh-server 实测监听 60000/60001）
udp dport 60000-61000 accept
# tsshd（rootshell Roam-tssh）：端口范围 61001-61020，绑 tailscale0
udp dport 61001-61020 accept
